# DocuMind Environment Configuration

# ============================================
# LLM Provider Configuration
# ============================================

# Groq API Key (FREE - Get from https://console.groq.com)
# Groq offers free access to Llama 3.1/3.3 and Mixtral models
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (Optional - for GPT models)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (Optional - for Claude models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Cohere API Key (Optional - for reranking)
COHERE_API_KEY=your_cohere_api_key_here

# ============================================
# Vector Store (Qdrant)
# ============================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ============================================
# Database
# ============================================
DATABASE_URL=postgresql+asyncpg://documind:documind@localhost:5432/documind

# ============================================
# Cache (Redis)
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# Storage (GCS/S3)
# ============================================

# Storage provider: "gcs" (default) or "s3"
STORAGE_PROVIDER=gcs

# GCS Configuration (default - uses Application Default Credentials)
GCS_BUCKET_NAME=documind-documents
GCP_PROJECT_ID=your-project-id
# Optional: path to service account key (leave empty to use ADC)
GOOGLE_APPLICATION_CREDENTIALS=

# S3 Configuration (optional - for AWS deployments)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=documind-documents

# ============================================
# Monitoring
# ============================================
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=documind
LANGSMITH_TRACING_V2=true

# ============================================
# Application
# ============================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-in-production

# ============================================
# Local Inference (Ollama + TEI)
# Set these when running make local-deploy
# ============================================

# Switch LLM to Ollama (no API key needed)
# DEFAULT_MODEL=llama3.2:3b-instruct-q4_K_M   # fast, ~2GB VRAM
# SIMPLE_MODEL=llama3.2:3b-instruct-q4_K_M
# COMPLEX_MODEL=llama3.1:8b-instruct-q4_K_M   # better quality, ~5GB VRAM

# Switch embeddings to local TEI (1024 dims — update Qdrant dimension too)
# EMBEDDING_PROVIDER=local-api
# QDRANT_EMBEDDING_DIMENSION=1024

# TEI service URLs (started by make local-deploy)
# TEI_EMBEDDINGS_URL=http://localhost:7997
# TEI_RERANKER_URL=http://localhost:7998
# OLLAMA_URL=http://localhost:11434

# Disable cloud storage for local dev
# STORAGE_PROVIDER=local
# LOCAL_STORAGE_PATH=./data/storage
